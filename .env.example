# Neon Postgres (pooled connection string)
DATABASE_URL=

# Session + PIN auth
SESSION_SECRET=generate-a-long-random-string
PIN_SALT=generate-another-random-string
CHARU_PIN=1234
SHREYA_PIN=5678

# AI — DeepSeek preferred when set; Kimi is fallback
# If Kimi returns 429/insufficient balance, add DEEPSEEK_API_KEY or recharge Kimi
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# KIMI_API_KEY=
# KIMI_MODEL=moonshot-v1-8k
# AI_PROVIDER=deepseek   # or kimi — forces order when both keys exist

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App URL (no trailing slash) — OAuth redirects
# Use 127.0.0.1 (not localhost) — Spotify rejects localhost redirect URIs
APP_BASE_URL=http://127.0.0.1:3000

# Weather (Open-Meteo, no API key) — defaults to Austin TX
WEATHER_LAT=30.2672
WEATHER_LON=-97.7431

# Spotify OAuth — redirect must be loopback IP (not localhost):
#   http://127.0.0.1:3000/api/oauth/spotify/callback
# Browser playback requires Spotify Premium + RECONNECT after adding keys
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
